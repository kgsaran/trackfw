name: trackfw validate
on:
  # push on main only. With a combined trigger (push + pull_request), a branch
  # from the same repository fires BOTH events on the same commit and the gate
  # runs twice — measured in a real PR: 2 runs of the same job, same SHA.
  push:
    branches: [main]
  pull_request:
jobs:
  governance-go-install:
    # Job id governance-go-install is a required_status_checks contract (ADR-2026-10-30 D3);
    # the id no longer describes the install mechanism. Do not rename.
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      TRACKFW_VERSION: "TRACKFW_VERSION_PLACEHOLDER"
    steps:
      - uses: actions/checkout@v7

      - name: Install trackfw
        run: curl -sSfL "https://github.com/kgsaran/trackfw/releases/download/v${TRACKFW_VERSION}/install.sh" | sh

      - run: trackfw validate
