{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/scripts/trackfw-attention-cleanup.sh",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/scripts/trackfw-attention-signal.sh",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard git-branch; exit $LASTEXITCODE",
            "type": "command"
          },
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
