{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/scripts/trackfw-attention-signal.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/scripts/trackfw-attention-cleanup.sh\"",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/scripts/trackfw-credential-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/scripts/trackfw-credential-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/scripts/trackfw-git-branch-guard.sh\"",
            "type": "command"
          },
          {
            "command": "\"$(git rev-parse --show-toplevel)/scripts/trackfw-credential-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/scripts/trackfw-credential-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ]
  }
}
