{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "scripts/trackfw-attention-signal.sh",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "scripts/trackfw-attention-cleanup.sh",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
