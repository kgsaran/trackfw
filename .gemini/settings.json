{
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-attention-cleanup.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-credential-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-credential-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "read_file|read_many_files"
      },
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-credential-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-git-branch-guard.sh",
            "type": "command"
          },
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-credential-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-credential-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "read_file|read_many_files"
      },
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-credential-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-attention-signal.sh",
            "type": "command"
          }
        ],
        "matcher": "ToolPermission"
      }
    ]
  }
}
