{
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-attention-cleanup.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "read_file|read_many_files"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "trackfw guard git-branch; exit $LASTEXITCODE",
            "type": "command"
          },
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "read_file|read_many_files"
      },
      {
        "hooks": [
          {
            "command": "trackfw guard credential; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "write_file|replace"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "$GEMINI_PROJECT_DIR/scripts/trackfw-attention-signal.sh",
            "type": "command"
          }
        ],
        "matcher": "ToolPermission"
      }
    ]
  }
}
